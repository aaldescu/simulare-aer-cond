# Copiază în `.env` și completează pentru deployment (Dokploy citește și el
# aceste variabile din secțiunea Environment a serviciului).

# Domeniul public pe care Traefik expune aplicația (fără http://).
DOMAIN=simulare.exemplu.ro

# Portul intern pe care ascultă aplicația în container (rar trebuie schimbat).
PORT=3000

# Unde ține serverul baza SQLite în container (montată ca volum -> persistă).
DATA_DIR=/app/data
